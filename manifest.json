{
  "manifest_version": 3,
  "name": "Disney Watch Party (Hunty)",
  "version": "3.1.0",
  "description": "Watch Disney+ in sync with friends far away. Chat, GIFs and reactions in the side panel. Free, no account.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Disney Watch Party",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.disneyplus.com/*"
      ],
      "js": [
        "peerjs.min.js",
        "src/state.js",
        "src/net.js",
        "src/player.js",
        "src/sync.js",
        "src/ui.js",
        "src/main.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/bridge.js"
      ],
      "matches": [
        "*://*.disneyplus.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://api.klipy.com/*",
    "https://raw.githubusercontent.com/*"
  ]
}
